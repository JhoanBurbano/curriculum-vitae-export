# ---------------------------------------------------------------------------
# Analítica
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------------
# Entrega de leads  —  SIN ESTO EL FORMULARIO NO ENTREGA NADA
#
# Hasta el 2026-08-05 los leads se escribían en .data/leads.jsonl con `fs`. En
# Vercel el filesystem es de solo lectura fuera de /tmp, así que producción
# devolvía 500 y cada solicitud se perdía. Ahora el lead sale por uno de estos
# dos canales; si no hay ninguno, el formulario ofrece un mailto para que la
# solicitud llegue igual, pero conviene configurar uno.
#
# Opción A — Resend (recomendada). Crea la cuenta, verifica el dominio y saca
# la API key. LEADS_FROM_EMAIL debe ser de un dominio verificado; si no lo
# tienes todavía, deja el default de onboarding@resend.dev.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=

# Opción B — cualquier webhook (Zapier, Make, n8n, Slack, un Sheet).
# Recibe el lead como JSON con un campo `text` ya formateado.
LEADS_WEBHOOK_URL=

# Suscripciones al blog. Si se omite, reutiliza LEADS_WEBHOOK_URL.
SUBSCRIBE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# Se usa en canonical, sitemap, RSS y tarjetas sociales. Si falta, cae a
# seo.siteUrl de cv-copy.json.
NEXT_PUBLIC_SITE_URL=https://www.jsburbano.dev
